# Generate fresh LOCAL-ONLY synthetic infrastructure credentials:
# python3 scripts/init-demo-env.py
# Do not copy production credentials here. Empty values intentionally cannot start Compose.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
# Local Mock HMAC only; never use a production credential.
M1_MOCK_WEBHOOK_SECRET=

# Optional host-port overrides when other local services already use these ports.
# Internal container ports and loopback-only exposure remain fixed.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
API_HOST_PORT=8080
WEB_HOST_PORT=4173

# M3 local Mock controls: never enable a real payment channel.
APP_PAYMENT_EMERGENCY_STOP=false
APP_MOCK_PAYMENT_WORKER_ENABLED=true
